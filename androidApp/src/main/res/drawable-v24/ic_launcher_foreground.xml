<?xml version="1.0" encoding="utf-8"?>
<!--
  Ícono de la app = león cian de BaskeTV (mismo icon-512 de la PWA web).
  Va inseteado ~18dp dentro del lienzo de 108dp del adaptive icon para caer en
  la zona segura (círculo de 72dp) y que la máscara del launcher no corte orejas
  ni melena.
-->
<inset xmlns:android="http://schemas.android.com/apk/res/android"
    android:drawable="@drawable/ic_lion"
    android:inset="28dp" />
